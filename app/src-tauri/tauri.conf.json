{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Margem",
  "version": "0.1.18",
  "identifier": "br.margem.app",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Margem", "width": 1200, "height": 800, "dragDropEnabled": false }], "security": { "assetProtocol": { "enable": true, "scope": [] }, "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'", "devCsp": null } },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"] } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGMkI3QkNENkQ5NDdENDcKUldSSGZaUnR6WHNyYitUMWJFMUlLYnJ4UmVCakpiY2FLa2dCeHdPalArS0U0b00xZHZLWG1Ca1kK",
      "endpoints": ["https://github.com/pergher/margem/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
